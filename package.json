{
  "name": "mgobeaalcoba-github-io",
  "version": "4.0.0",
  "description": "Multi-site portfolio: Mariano Gobea Alcoba — Data & Analytics Technical Leader. Next.js 14+ static sites for personal portfolio, MGA Tech Consulting, and client projects.",
  "author": "Mariano Gobea Alcoba",
  "license": "UNLICENSED",
  "homepage": "https://mgobeaalcoba.github.io/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mgobeaalcoba/Mgobeaalcoba.github.io.git"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "bootstrap": "npm ci",
    "dev": "npm run dev --workspace=cv",
    "dev:neil": "npm run dev --workspace=neil-landing",
    "dev:elportugues": "npm run dev --workspace=elportugues-landing",
    "build": "node scripts/build-workspace.mjs cv",
    "build:neil": "node scripts/build-workspace.mjs neil",
    "build:elportugues": "node scripts/build-workspace.mjs el-portugues",
    "build:all": "npm run build && npm run build:neil && npm run build:elportugues",
    "check": "npm run doctor && npm run build:all && npm run check:static",
    "check:root": "node scripts/check-root.mjs",
    "check:static": "node scripts/smoke-static.mjs",
    "doctor": "node scripts/doctor.mjs && npm run check:root",
    "deploy": "bash scripts/build-deploy.sh",
    "format": "prettier --write '**/*.{html,css,js,ts,tsx,json}' --ignore-path .prettierignore"
  },
  "devDependencies": {
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.0.0",
    "sharp": "^0.35.3"
  },
  "keywords": [
    "portfolio",
    "consulting",
    "nextjs",
    "data-analytics",
    "technical-leader",
    "typescript",
    "tailwindcss"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      "glob": "10.5.0"
    },
    "@supabase/realtime-js": {
      "ws": "8.21.1"
    }
  }
}
